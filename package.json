  "license": "GPL-3.0-only",
  "overrides": {
    "dompurify": "3.4.13"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-bridge.mjs",
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "npm run build && wrangler dev --port 8787",
    "prebuild": "node scripts/sync-bridge.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:dead-code": "knip --no-progress",
    "check": "npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "bridge": "node packages/bridge/src/index.mjs"
  },
  "dependencies": {
